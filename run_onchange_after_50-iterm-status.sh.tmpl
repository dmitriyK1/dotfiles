#!/bin/bash
# Codex hook: {{ include "private_dot_config/iterm2/codex-status.py" | sha256sum }}
# Installer: {{ include "private_dot_config/iterm2/install-codex-status.py" | sha256sum }}
# Claude hook: {{ include "private_dot_config/iterm2/executable_cc-status-green.py" | sha256sum }}
# Launcher: {{ include "private_dot_config/iterm2/codex-launch.sh" | sha256sum }}
# Fish: {{ include "private_dot_config/private_fish/functions/codex.fish" | sha256sum }}
if [[ "$(uname -s)" != Darwin ]]; then
    exit 0
fi
if [[ ! -x /Applications/iTerm.app/Contents/Resources/utilities/it2 ]] && [[ ! -x "$HOME/Applications/iTerm.app/Contents/Resources/utilities/it2" ]]; then
    echo "Skipping iTerm status setup: install iTerm2 first."
    exit 0
fi
# The installer registers Claude hooks alone when Codex is missing.
if ! command -v codex >/dev/null 2>&1 && ! command -v claude >/dev/null 2>&1 && [[ ! -d "$HOME/.claude" ]]; then
    echo "Skipping iTerm status setup: install Codex or Claude Code first."
    exit 0
fi
/usr/bin/python3 "$HOME/.config/iterm2/install-codex-status.py"
