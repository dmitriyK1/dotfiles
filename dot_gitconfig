[gpg]
	format = ssh
[commit]
	gpgsign = true
[push]
	autoSetupRemote = true
[alias]
	sync = !/opt/homebrew/bin/legit sync
	publish = !/opt/homebrew/bin/legit publish
	unpublish = !/opt/homebrew/bin/legit unpublish
	undo = !/opt/homebrew/bin/legit undo
	branches = !/opt/homebrew/bin/legit branches
	recommit = commit --amend --no-edit
	# syntax-aware side-by-side diff via difftastic (git dft, git dft HEAD~1)
	dft = -c diff.external=difft diff --ext-diff
[core]
	excludesfile = ~/.gitignore_global
	pager = delta
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	# truncate long lines instead of wrapping them (no ↴ / … continuation rows)
	wrap-max-lines = 0
	# restyle git's moved-line colors: keep syntax highlighting, tint the background instead
	# (purple/blue = moved from, cyan/yellow = moved to; the alternates mark adjacent blocks)
	map-styles = bold purple => syntax "#6b1f5c", bold blue => syntax "#2d3f8f", bold cyan => syntax "#00665c", bold yellow => syntax "#5c5c00"
[diff]
	# color moved lines differently from real additions/removals
	colorMoved = zebra
	# still count a block as moved when it's uniformly re-indented, e.g. wrapped in an if
	colorMovedWS = allow-indentation-change
[merge]
	conflictStyle = zdiff3
[rerere]
	# remember how conflicts were resolved and reapply the resolution automatically
	enabled = true
[pull]
	# replay local commits on top of upstream instead of creating merge commits
	rebase = true
# Machine-specific settings (user.email, user.signingkey); keep last so it can override the above
[include]
	path = ~/.gitconfig.local
