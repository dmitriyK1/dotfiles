#!/bin/bash
# Install oh-my-fish (bobthefish theme) and fisher plugins; re-runs when either plugin list changes.
# omf bundle hash: {{ include "private_dot_config/omf/private_bundle" | sha256sum }}
# fish_plugins hash: {{ include "private_dot_config/private_fish/fish_plugins" | sha256sum }}
set -euo pipefail

eval "$(/opt/homebrew/bin/brew shellenv)"

if [ ! -d "$HOME/.local/share/omf" ]; then
  echo "Installing oh-my-fish..."
  installer="$(mktemp)"
  curl -fsSL https://raw.githubusercontent.com/oh-my-fish/oh-my-fish/master/bin/install -o "$installer"
  fish "$installer" --noninteractive --yes
  rm -f "$installer"
fi
# with no arguments, omf installs everything listed in ~/.config/omf/bundle
fish -c 'omf install'

# fisher itself comes from Homebrew; this installs the plugins listed in ~/.config/fish/fish_plugins
fish -c 'fisher update'
