# compare current branch with a specified remote branch
function gdrb
    if test (count $argv) -ne 1; or test -z "$argv[1]"
        echo "usage: gdrb BRANCH" >&2
        return 2
    end
    git fetch origin; or return
    git diff "...origin/$argv[1]"
end

# compare logs of a current branch with a specified remote branch
function glrb
    if test (count $argv) -ne 1; or test -z "$argv[1]"
        echo "usage: glrb BRANCH" >&2
        return 2
    end
    git fetch origin; or return
    git log "...origin/$argv[1]"
end

function mkcd
    if test (count $argv) -ne 1; or test -z "$argv[1]"
        echo "usage: mkcd DIRECTORY" >&2
        return 2
    end
    command mkdir -pv -- "$argv[1]"; or return
    cd -- "$argv[1]"
end

function commit-count
    git rev-list --count HEAD
end

function count_commits
    commit-count
end

function diff_commits
    if test $argv[1]
        git log --left-right --graph --cherry-pick --oneline (git rev-parse --abbrev-ref HEAD)...$argv[1]
    else
        echo "Branch name is required"
    end
end

function yy
    set tmp (mktemp -t "yazi-cwd.XXXXXX")
    yazi $argv --cwd-file="$tmp"
    if set cwd (command cat -- "$tmp"); and [ -n "$cwd" ]; and [ "$cwd" != "$PWD" ]
        builtin cd -- "$cwd"
    end
    rm -f -- "$tmp"
end

