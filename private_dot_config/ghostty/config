# Ghostty settings; list all options with `ghostty +show-config --default --docs`
# Nerd Font icons (eza, Tide) come from FiraCode Nerd Font
font-family = "FiraCode Nerd Font"
font-size = 15

cursor-style = underline
# Ghostty's shell integration switches the cursor to a bar at the prompt
shell-integration-features = no-cursor
